<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پنل میزبان | GatePass360</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/panel-host.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="logo">
                <i class="fas fa-door-closed"></i>
                <a href="/" style="text-decoration: none; color: inherit;">
                    GatePass<span class="highlight">360</span>
                </a>
            </div>
            <div class="nav-links">
                <a href="/">خانه</a>
            </div>
        </div>
    </nav>

    <div class="panel-container">
        <div class="panel-header">
            <div class="user-info">
                <div class="user-icon">
                    <i class="fas fa-briefcase"></i>
                </div>
                <div>
                    <h3 id="userName">میزبان</h3>
                    <p style="color: #666; font-size: 0.9rem;">🏢 نقش: میزبان</p>
                </div>
            </div>
            <button class="logout-btn" id="logoutBtn">
                <i class="fas fa-sign-out-alt"></i> خروج
            </button>
        </div>

        <div class="card">
            <h2 class="card-title">درخواست‌های در انتظار تأیید</h2>
            <table class="requests-table">
                <thead>
                    <tr>
                        <th>مهمان</th>
                        <th>تاریخ</th>
                        <th>هدف</th>
                        <th>توضیحات</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="pendingRequests">
                </tbody>
            </table>
        </div>

        <div class="card">
            <h2 class="card-title">تاریخچه درخواست‌ها</h2>
            <table class="requests-table">
                <thead>
                    <tr>
                        <th>مهمان</th>
                        <th>تاریخ</th>
                        <th>هدف</th>
                        <th>وضعیت</th>
                        <th>توضیحات</th>
                    </tr>
                </thead>
                <tbody id="requestHistory">
                </tbody>
            </table>
        </div>
    </div>

    <script src="/javascripts/auth.js"></script>
    <script src="/javascripts/panel.js"></script>
    <script src="/javascripts/panel-host.js"></script>
    <script>
        (async function() {
            const user = await initPanel(['host'], function(user) {
                displayUserInfo(user);
            });
        })();
    </script>
</body>
</html>
